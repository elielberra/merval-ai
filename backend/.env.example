# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Required for the news summary and per-stock explanations (the Claude API).
# The .env file is gitignored — never commit your real key.
ANTHROPIC_API_KEY=

# Required only when strategies/small_daily_gains/config.py sets DATA_SOURCE="ppi".
# Generate them in your PPI account under Gestiones -> Gestión de servicio API.
PPI_API_KEY=
PPI_API_SECRET=
