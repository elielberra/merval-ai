# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Required for the news summary and per-stock explanations (the Claude API).
# The .env file is gitignored — never commit your real key.
ANTHROPIC_API_KEY=

# Required only when strategies/small_daily_gains/config.py sets DATA_SOURCE="ppi".
# Generate them in your PPI account under Gestiones -> Gestión de servicio API,
# where they are shown as a "key pública" and a "key privada":
#
#   ..._PUBLIC_API_KEY  = the "key pública"  (sent as the ApiKey header)
#   ..._PRIVATE_API_KEY = the "key privada"  (sent as the ApiSecret header)
#
# The AuthorizedClient / ClientKey values also shown on that page are NOT needed
# here — the official ppi-client Python package hardcodes its own pair.
#
# Sandbox and Production are DIFFERENT key pairs — PPI shows Production keys
# only once, at account activation, and never resends them. Keep both sets
# here; IS_PPI_PROD in strategies/small_daily_gains/config.py picks which
# pair gets used, so switching environments never requires editing this file.
#
# PPI's Sandbox backend has been observed returning 504 Gateway Time-out on
# login (confirmed independent of credentials/headers — Production logs in
# fine at the same time). If DATA_SOURCE="ppi" with IS_PPI_PROD=False starts
# failing, check Sandbox isn't just down before assuming a config problem.
PPI_SANDBOX_PUBLIC_API_KEY=
PPI_SANDBOX_PRIVATE_API_KEY=
PPI_PROD_PUBLIC_API_KEY=
PPI_PROD_PRIVATE_API_KEY=
